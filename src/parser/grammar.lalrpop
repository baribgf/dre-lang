use crate::token::Token;
use crate::ast::*;

use super::utils::*;

grammar;

extern {
    type Location = usize;
    type Error = String;

    enum Token {
        "Newline" => Token::Newline,
        "Use" => Token::Use,
        "Let" => Token::Let,
        "Struct" => Token::Struct,
        "Enum" => Token::Enum,
        "Prot" => Token::Prot,
        "Func" => Token::Func,
        "Begin" => Token::Begin,
        "End" => Token::End,
        "Is" => Token::Is,
        "Pub" => Token::Pub,
        "Self" => Token::Self_,
        "Return" => Token::Return,
        "Until" => Token::Until,
        "While" => Token::While,
        "For" => Token::For,
        "Do" => Token::Do,
        "In" => Token::In,
        "If" => Token::If,
        "Then" => Token::Then,
        "Else" => Token::Else,
        "TrueLtrl" => Token::TrueLtrl,
        "FalseLtrl" => Token::FalseLtrl,
        "Not" => Token::Not,
        "And" => Token::And,
        "Or" => Token::Or,
        "Inc" => Token::Inc,
        "Dec" => Token::Dec,
        "Const" => Token::Const,
        "SpacedColon" => Token::SpacedColon,
        "DoubleColon" => Token::DoubleColon,
        "Eq" => Token::Eq,
        "Diamond" => Token::Diamond,
        "Lt" => Token::Lt,
        "Lte" => Token::Lte,
        "Gt" => Token::Gt,
        "Gte" => Token::Gte,
        "OpenParen" => Token::OpenParen,
        "ClosParen" => Token::ClosParen,
        "OpenBracket" => Token::OpenBracket,
        "ClosBracket" => Token::ClosBracket,
        "SpacedComma" => Token::SpacedComma,
        "RightArrow" => Token::RightArrow,
        "LeftArrow" => Token::LeftArrow,
        "Period" => Token::Period,
        "DoublePeriod" => Token::DoublePeriod,
        "Add" => Token::Add,
        "Sub" => Token::Sub,
        "Mul" => Token::Mul,
        "Div" => Token::Div,
        "Mod" => Token::Mod,
        "ShiftL" => Token::ShiftL,
        "ShiftR" => Token::ShiftR,
        "Pipe" => Token::Pipe,
        "Ampersand" => Token::Ampersand,
        "Hat" => Token::Hat,
        "Tilde" => Token::Tilde,
        "IntegerLtrl" => Token::IntegerLtrl(int_ltrl),
        "FloatLtrl" => Token::FloatLtrl(float_ltrl),
        "CharLtrl" => Token::CharLtrl(char_ltrl),
        "StringLtrl" => Token::StringLtrl(str_ltrl),
        "MultiComment" => Token::MultiComment,
        "SingleComment" => Token::SingleComment,
        "Identifier" => Token::Identifier(identifier),
    }
}

pub Program: Program = {
    <h:Header> <c:Constructs> => Program::new(h, c),
};

Header: Header = { <u:(<Use> "Newline")*> => u };
Use: UseStmt = { "Use" <q:QualName> => q };

QualName: Vec<String> = {
    <h:"Identifier"> <t:("DoubleColon" <"Identifier">)*> => extract_ids(h, t),
};

DeclHead: () = { "Let" "Pub"? => () };
VarDecl: () = { DeclHead VarDeclBody => () };
VarDeclBody: () = {
    "Identifier" "SpacedColon" Type ("LeftArrow" Expr)? => (),
    "Const" "Identifier" "SpacedColon" Type "Eq" Expr => (),
};

Type: () = {
    QualName => (),
    "OpenBracket" "IntegerLtrl"? Type "ClosBracket" => (),
};
TypeDeclHead: () = { DeclHead "Identifier" "SpacedColon" => () };

Constructs: Vec<Construct> = {
    <c:(<Construct> "Newline")*> => c,
};

Construct: Construct = {
    EnumDef => Construct::EnumDef,
    StructDef => Construct::StructDef,
    ProtDef => Construct::ProtDef,
    FuncDef => Construct::FuncDef,
    VarDecl => Construct::VarDecl,
};

ProtImpos: () = { "Is" QualName ("SpacedComma" QualName)* => () };

EnumDef: () = {
    TypeDeclHead "Enum" "Newline" "Begin" "Newline" EnumBody "End" => ()
};
EnumBody: () = { (EnumElem "Newline")* => () };
EnumElem: () = { "Identifier" ("Eq" "IntegerLtrl")? };

StructDef: () = {
    TypeDeclHead "Struct" ProtImpos? "Newline" "Begin" "Newline" StructBody "End" => ()
};
StructBody: () = { (Member "Newline")* => () };
Member: () = {
    VarDecl => (),
    FuncDef => (),
};

ProtDef: () = { TypeDeclHead "Prot" ProtImpos? "Newline" "Begin" "Newline" ProtBody "End" => () };
ProtBody: () = { (FuncDecl ("Newline" FuncBlock)? "Newline")* => () };

FuncDef: () = { FuncDecl "Newline" FuncBlock => () };
FuncDecl: () = { TypeDeclHead "Func" "OpenParen" FuncParams? "ClosParen" "RightArrow" Type => () };
FuncBlock: () = { "Begin" "Newline" Statements "End" => () };
FuncParams: () = { FuncParam ("SpacedComma" FuncParam)* => () };
FuncParam: () = { "Identifier" "SpacedColon" Type => () };

Statements: () = {
    (Statement "Newline")* => (),
};

Statement: () = {
    VarDecl => (),
    FuncDef => (),
    Assignment => (),
    UntilLoop => (),
    WhileLoop => (),
    ForLoop => (),
    IfElse => (),
    FuncCall => (),
    Return => (),
    Increment => (),
    Decrement => (),
};

FuncCall: () = { PrimaryExprPrime PostfixOp* "OpenParen" FuncArgs? "ClosParen" => () };

Assignment: () = { LValue "LeftArrow" RValue => () };
LValue: () = { PrimaryExprPrime PostfixOp* => () };
RValue: () = { Expr => () };

UntilLoop: () = { "Until" Expr DoBlock => () };
WhileLoop: () = { "While" Expr DoBlock => () };

ForLoop: () = { "For" "Identifier" "In" Expr DoBlock => () };

DoBlock: () = { "Do" "Newline" Statements "End" => () };

IfElse: () = { If ElseIf* Else? "End" };
If: () = { "If" Expr "Then" "Newline" Statements };
ElseIf: () = { "Else" If };
Else: () = { "Else" "Newline" Statements };

FuncArgs: () = { FuncArg ("SpacedComma" FuncArg)* => () };
FuncArg: () = { Expr => () };

Return: () = { "Return" Expr => () };
Increment: () = { "Inc" LValue => () };
Decrement: () = { "Dec" LValue => () };
Call: () = { "OpenParen" FuncArgs? "ClosParen" => () };
Index: () = { "OpenBracket" Expr "ClosBracket" => () };

Expr: () = { OrExpr => () };
OrExpr: () = { AndExpr ("Or" AndExpr)* => () };
AndExpr: () = { BitOr ("And" BitOr)* => () };
BitOr: () = { BitXor ("Pipe" BitXor)* => () };
BitXor: () = { BitAnd ("Hat" BitAnd)* => () };
BitAnd: () = { RelExpr ("Ampersand" RelExpr)* => () };
RelExpr: () = { ShiftExpr (RelOp ShiftExpr)* => () };
ShiftExpr: () = { RngExpr (ShiftOp RngExpr)* => () };
RngExpr: () = { AddExpr ("DoublePeriod" AddExpr)? => () };
AddOp: () = {
    "Add" => (),
    "Sub" => (),
};
AddTail: () = { AddOp MulExpr => () };
AddExpr: () = { MulExpr AddTail* => () };

MulOp: () = {
    "Mul" => (),
    "Div" => (),
    "Mod" => (),
};
MulTail: () = { MulOp UnaryExpr => () };
MulExpr: () = { UnaryExpr MulTail* => () };

UnaryOp: () = {
    "Add" => (),
    "Sub" => (),
    "Not" => (),
    "Tilde" => (),
};
UnaryExpr: () = {
    UnaryOp UnaryExpr => (),
    PostfixExpr => (),
};

PostfixExpr: () = { PrimaryExpr PostfixOp* => () };

PostfixOp: () = {
    Call => (),
    Index => (),
    "Period" "Identifier" => (),
};

PrimaryExpr: () = {
    "StringLtrl" => (),
    "CharLtrl" => (),
    "IntegerLtrl" => (),
    "FloatLtrl" => (),
    "TrueLtrl" => (),
    "FalseLtrl" => (),
    "OpenParen" Expr "ClosParen" => (),
    PrimaryExprPrime => (),
};

PrimaryExprPrime: () = {
    "Self" => (),
    QualName => (),
};

ShiftOp: () = {
    "ShiftL" => (),
    "ShiftR" => (),
};

RelOp: () = {
    "Eq" => (),
    "Diamond" => (),
    "Lt" => (),
    "Lte" => (),
    "Gt" => (),
    "Gte" => (),
};
