use std::io
use regex::core::dfa

use .utils::Something


let pub active: Bool

---
This is a multi-line comment
---

-- This is a single line comment

let DeathReason: enum
begin
    Normal  = 0
    Murder  = 1
    Unknown = 2
end

let Mortal: prot
begin
    let default: func () -> None
    begin
        -- Some default behaviour
    end

    let die: func (reason: DeathReason) -> None
end

let Person: struct is Mortal --, ...
begin
    -- Here, begins the public section
    let name: String <- “”
    let age: Int <- 0

    let pub @new: func (name: String, age: Int) -> None
    begin
        self.name <- name
        self.GetName().length <- 1
        Module::getSomething().attr <- 0
        self.age <- age
    end

    let pub GetName: func () -> String
    begin
        return self.name
    end

    let pub die: func (reason: DeathReason) -> None
    begin
        io::PrintLn(“Mr. ”, self.GetName(), “ passes away..”)
        io::PrintLn(“Because: ”, reason.ToString())
    end
end

---
This is the entry-point of the program, the `main` function.
---
let main: func (argc: Int, argv: [String]) -> Int
begin
    io::PrintLn(“Hello, world!”)

    let x: Int
    let person: Person

    let point: [2 Int]
    point[0] <- 1
    point[1] <- 2

    x <- 0
    until x = 5 do
        x <- x + 1
    end

    for i in 1..5 do
        dec x
    end

    if x = 0 then
        -- loop ranges are bijective
    else if x <> 0 then
        -- they'ren't
    else
        -- oops!!
        io::Oops(“Something went wrong!”)
    end

    let const AGE: Int = 21
    person <- Person::new(“Abdelbari”, AGE)
    io::PrintLn(“Hello, ”, person.GetName(), “!”)
    person.make().life.kill().spawn()

    Module::x <- 0

    let finished: Bool <- True

    while not finished do
        doShout()
    end

    person.die(DeathReason::Unknown)

    return 0
end

let doShout: func () -> None
begin
    io::PrintLn(“Okay, I'm not gonna do that!”)
end
