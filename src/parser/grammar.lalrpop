use crate::token::Token;

grammar;

extern {
    type Location = usize;
    type Error = String;

    enum Token {
        "Newline" => Token::Newline,
        "Use" => Token::Use,
        "Let" => Token::Let,
        "Struct" => Token::Struct,
        "Enum" => Token::Enum,
        "Prot" => Token::Prot,
        "Func" => Token::Func,
        "Begin" => Token::Begin,
        "End" => Token::End,
        "Is" => Token::Is,
        "Pub" => Token::Pub,
        "Self" => Token::Self_,
        "Return" => Token::Return,
        "Until" => Token::Until,
        "While" => Token::While,
        "For" => Token::For,
        "Do" => Token::Do,
        "In" => Token::In,
        "If" => Token::If,
        "Then" => Token::Then,
        "Else" => Token::Else,
        "TrueLtrl" => Token::TrueLtrl,
        "FalseLtrl" => Token::FalseLtrl,
        "Not" => Token::Not,
        "And" => Token::And,
        "Or" => Token::Or,
        "Inc" => Token::Inc,
        "Dec" => Token::Dec,
        "Const" => Token::Const,
        "SpacedColon" => Token::SpacedColon,
        "DoubleColon" => Token::DoubleColon,
        "Eq" => Token::Eq,
        "Diamond" => Token::Diamond,
        "Lt" => Token::Lt,
        "Lte" => Token::Lte,
        "Gt" => Token::Gt,
        "Gte" => Token::Gte,
        "OpenParen" => Token::OpenParen,
        "ClosParen" => Token::ClosParen,
        "OpenBracket" => Token::OpenBracket,
        "ClosBracket" => Token::ClosBracket,
        "SpacedComma" => Token::SpacedComma,
        "RightArrow" => Token::RightArrow,
        "LeftArrow" => Token::LeftArrow,
        "Period" => Token::Period,
        "DoublePeriod" => Token::DoublePeriod,
        "Add" => Token::Add,
        "Sub" => Token::Sub,
        "Mul" => Token::Mul,
        "Div" => Token::Div,
        "Mod" => Token::Mod,
        "ShiftL" => Token::ShiftL,
        "ShiftR" => Token::ShiftR,
        "Pipe" => Token::Pipe,
        "Ampersand" => Token::Ampersand,
        "Hat" => Token::Hat,
        "Tilde" => Token::Tilde,
        "IntegerLtrl" => Token::IntegerLtrl(int_ltrl),
        "FloatLtrl" => Token::FloatLtrl(float_ltrl),
        "StringLtrl" => Token::StringLtrl(str_ltrl),
        "MultiComment" => Token::MultiComment,
        "SingleComment" => Token::SingleComment,
        "Identifier" => Token::Identifier(identifier),
    }
}

pub Program = { "Identifier" };
