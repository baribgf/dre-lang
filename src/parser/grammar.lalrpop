use crate::token::Token;
use crate::ast::*;
use crate::utils::{Loc, Span};

use super::utils::*;

grammar;

extern {
    type Location = Loc;
    type Error = String;

    enum Token {
        "Newline" => Token::Newline,
        "Use" => Token::Use,
        "Let" => Token::Let,
        "Struct" => Token::Struct,
        "Enum" => Token::Enum,
        "Prot" => Token::Prot,
        "Func" => Token::Func,
        "Begin" => Token::Begin,
        "End" => Token::End,
        "Is" => Token::Is,
        "Pub" => Token::Pub,
        "Self" => Token::Self_,
        "Return" => Token::Return,
        "Until" => Token::Until,
        "While" => Token::While,
        "For" => Token::For,
        "Do" => Token::Do,
        "In" => Token::In,
        "Break" => Token::Break,
        "Skip" => Token::Skip,
        "If" => Token::If,
        "Then" => Token::Then,
        "Else" => Token::Else,
        "TrueLtrl" => Token::TrueLtrl,
        "FalseLtrl" => Token::FalseLtrl,
        "Not" => Token::Not,
        "And" => Token::And,
        "Or" => Token::Or,
        "Inc" => Token::Inc,
        "Dec" => Token::Dec,
        "Const" => Token::Const,
        "SpacedColon" => Token::SpacedColon,
        "DoubleColon" => Token::DoubleColon,
        "Eq" => Token::Eq,
        "Diamond" => Token::Diamond,
        "Lt" => Token::Lt,
        "Lte" => Token::Lte,
        "Gt" => Token::Gt,
        "Gte" => Token::Gte,
        "OpenParen" => Token::OpenParen,
        "ClosParen" => Token::ClosParen,
        "OpenBracket" => Token::OpenBracket,
        "ClosBracket" => Token::ClosBracket,
        "SpacedComma" => Token::SpacedComma,
        "RightArrow" => Token::RightArrow,
        "LeftArrow" => Token::LeftArrow,
        "Period" => Token::Period,
        "DoublePeriod" => Token::DoublePeriod,
        "Add" => Token::Add,
        "Sub" => Token::Sub,
        "Mul" => Token::Mul,
        "Div" => Token::Div,
        "Mod" => Token::Mod,
        "ShiftL" => Token::ShiftL,
        "ShiftR" => Token::ShiftR,
        "Pipe" => Token::Pipe,
        "Ampersand" => Token::Ampersand,
        "Hat" => Token::Hat,
        "Tilde" => Token::Tilde,
        "IntegerLtrl" => Token::IntegerLtrl(_),
        "FloatLtrl" => Token::FloatLtrl(_),
        "CharLtrl" => Token::CharLtrl(_),
        "StringLtrl" => Token::StringLtrl(_),
        "MultiComment" => Token::MultiComment,
        "SingleComment" => Token::SingleComment,
        "Identifier" => Token::Identifier(_),
    }
}

pub Program: Program = {
    <h:Header> <c:Constructs> => Program::new(h, c),
};

Header: Header = { <u:(<Use> "Newline"+)*> => u };
Use: UseStmt = {
    "Use" <p:"Period"?> <q:QualName> => UseStmt::new(p.is_some(), q)
};

QualName: QualName = {
    <h:"Identifier"> <t:("DoubleColon" <"Identifier">)*> => extract_ids(h, t),
};

DeclHead: bool = { "Let" <p:"Pub"?> => p.is_some() };
VarDecl: VarDecl = {
    <h:DeclHead> <b:VarDeclBody> => VarDecl::new(h, b.0, b.1, b.2, b.3)
};
VarDeclBody: (bool, String, Type, Option<Expr>) = {
    <id:"Identifier"> "SpacedColon" <t:Type> <v:("LeftArrow" <Expr>)?> => (false, id.identifier(), t, v),
    "Const" <id:"Identifier"> "SpacedColon" <t:Type> "Eq" <v:Expr> => (true, id.identifier(), t, Some(v)),
};

Type: Type = {
    <q:QualName> => Type::QualName(q),
    "OpenBracket" <id:"IntegerLtrl"?> <t:Type> "ClosBracket" => Type::ArrayOf(id.map(|inner| inner.int_ltrl()), t.into()),
};
TypeDeclHead: (bool, String, Span) = {
    <p:DeclHead> <start:@L> <id:"Identifier"> <end:@R> "SpacedColon" => (p, id.identifier(), (start, end))
};

Constructs: Vec<Construct> = {
    <c:(<Construct> "Newline"+)*> => c,
};

Construct: Construct = {
    <loc:@L> <x:EnumDef> => Construct::new(ConstructKind::EnumDef(x), loc),
    <loc:@L> <x:StructDef> => Construct::new(ConstructKind::StructDef(x), loc),
    <loc:@L> <x:ProtDef> => Construct::new(ConstructKind::ProtDef(x.into()), loc),
    <loc:@L> <x:FuncDef> => Construct::new(ConstructKind::FuncDef(x), loc),
    <loc:@L> <x:VarDecl> => Construct::new(ConstructKind::VarDecl(x), loc),
};

ProtImpos: Vec<QualName> = {
    "Is" <h:QualName> <t:("SpacedComma" <QualName>)*> => splice(h, t)
};

EnumDef: EnumDef = {
    <h:TypeDeclHead> "Enum" "Newline"
    "Begin" "Newline"+ <b:EnumBody> "End" => EnumDef::new(h.0, h.1, b)
};
EnumBody: Vec<EnumElem> = { <e:(<EnumElem> "Newline"+)*> => e };
EnumElem: EnumElem = {
    <start:@L> <n:"Identifier"> <end:@R> => {
        EnumElem::new(n.identifier(), (start, end))
    }
};

StructDef: StructDef = {
    <h:TypeDeclHead> "Struct" <pi:ProtImpos?> "Newline"
    "Begin" "Newline"+ <b:StructBody> "End" => StructDef::new(h.0, h.1, pi.unwrap_or(Vec::new()), b)
};
StructBody: Vec<StructMember> = {
    <m:(<StructMember> "Newline"+)*> => m
};
StructMember: StructMember = {
    <loc:@L> <f:FuncDef> => StructMember::new(StructMemberKind::FuncDef(f), (loc, loc)),
    <loc:@L> <v:VarDecl> => StructMember::new(StructMemberKind::VarDecl(v), (loc, loc)),
};

ProtDef: ProtDef = {
    <h:TypeDeclHead> "Prot" <pi:ProtImpos?> "Newline"
    "Begin" "Newline"+ <b:ProtBody> "End" => ProtDef::new(h.0, h.1, pi.unwrap_or(Vec::new()), b)
};
ProtBody: Vec<ProtMember> = {
    <m:(<FuncDecl> <("Newline" <FuncBlock>)?> "Newline"+)*> => m.into_iter().map(|item| ProtMember::new(item.0, item.1)).collect()
};

FuncDef: FuncDef = {
    <d:FuncDecl> "Newline" <s:FuncBlock> => FuncDef::new(d, s)
};
FuncDecl: FuncDecl = {
    <h:TypeDeclHead> "Func" "OpenParen" <p:FuncParams?> "ClosParen"
    "RightArrow" <t:Type> => FuncDecl::new(
        h.0,
        h.1,
        p.unwrap_or(Vec::new()),
        t,
        h.2
    )
};
FuncBlock: Vec<Statement> = {
    "Begin" "Newline"+ <s:Statements> "End" => s
};
FuncParams: Vec<FuncParam> = {
    <h:FuncParam> <t:("SpacedComma" <FuncParam>)*> => splice(h, t)
};
FuncParam: FuncParam = {
    <id:"Identifier"> "SpacedColon" <t:Type> => FuncParam::new(id.identifier(), t)
};

Statements: Vec<Statement> = {
    <s:(<Statement> "Newline"+)*> => s,
};

Statement: Statement = {
    <x:VarDecl> => Statement::VarDecl(x),
    <x:FuncDef> => Statement::FuncDef(x),
    <x:Assignment> => Statement::Assignment(x),
    <x:UntilLoop> => Statement::UntilLoop(x),
    <x:WhileLoop> => Statement::WhileLoop(x),
    <x:ForLoop> => Statement::ForLoop(x),
    <x:IfElse> => Statement::IfElse(x),
    <x:FuncCall> => Statement::FuncCall(x),
    <x:Return> => Statement::Return(x),
    "Break" => Statement::Break,
    "Skip" => Statement::Skip,
    <x:Increment> => Statement::Increment(x),
    <x:Decrement> => Statement::Decrement(x),
};

FuncCall: FuncCall = {
    <h:PrimaryExprPrime> <t:PostfixOp*> <c:Call> => FuncCall::new(h, t, c)
};

Assignment: Assignment = {
    <l:LValue> "LeftArrow" <r:RValue> => Assignment::new(l, r)
};
LValue: LValue = {
    <h:PrimaryExprPrime> <t:(<PostfixOp*> <PostfixOpPrime>)?> => LValue::new(h, t)
};
RValue: Expr = { <Expr> => <> };

UntilLoop: CondLoop = {
    "Until" <e:Expr> <b:DoBlock> => CondLoop::new(false, e, b)
};
WhileLoop: CondLoop = {
    "While" <e:Expr> <b:DoBlock> => CondLoop::new(true, e, b)
};

ForLoop: ForLoop = {
    "For" <id:"Identifier"> "In" <e:Expr> <b:DoBlock> => ForLoop::new(id.identifier(), e, b)
};

DoBlock: Vec<Statement> = { "Do" "Newline"+ <Statements> "End" => <> };

IfElse: IfElse = {
    <if_:If> <ei:ElseIf*> <e:Else?> "End" => IfElse::new(if_, ei, e.unwrap_or(Vec::new()))
};
If: If = {
    "If" <c:Expr> "Then" "Newline"+ <b:Statements> => If::new(c, b)
};
ElseIf: If = { "Else" <If> => <> };
Else: Vec<Statement> = { "Else" "Newline"+ <Statements> => <> };

FuncArgs: Vec<FuncArg> = {
    <h:FuncArg> <t:("SpacedComma" <FuncArg>)*> => splice(h, t)
};
FuncArg: FuncArg = { <Expr> => <> };

Return: Expr = { "Return" <Expr> => <> };
Increment: LValue = { "Inc" <LValue> => <> };
Decrement: LValue = { "Dec" <LValue> => <> };
Call: Call = {
    "OpenParen" <a:FuncArgs?> "ClosParen" => a.unwrap_or(Vec::new())
};
Index: Index = { "OpenBracket" <Expr> "ClosBracket" => <> };

Expr: Expr = { <OrExpr> => <> };
OrExpr: Vec<AndExpr> = {
    <h:AndExpr> <t:("Or" <AndExpr>)*> => splice(h, t)
};
AndExpr: AndExpr = { <h:BitOr> <t:("And" <BitOr>)*> => splice(h, t) };
BitOr: BitOr = { <h:BitXor> <t:("Pipe" <BitXor>)*> => splice(h, t) };
BitXor: BitXor = { <h:BitAnd> <t:("Hat" <BitAnd>)*> => splice(h, t) };
BitAnd: BitAnd = { <h:RelExpr> <t:("Ampersand" <RelExpr>)*> => splice(h, t) };
RelExpr: RelExpr = {
    <h:ShiftExpr> <t:(<RelOp> <ShiftExpr>)*> => splice((RelOp::Id, h), t)
};
ShiftExpr: ShiftExpr = {
    <h:RngExpr> <t:(<ShiftOp> <RngExpr>)*> => splice((ShiftOp::Left, h), t)
};
RngExpr: RngExpr = {
    <l:AddExpr> <r:("DoublePeriod" <AddExpr>)?> => (l, r)
};
AddOp: AddOp = {
    "Add" => AddOp::Add,
    "Sub" => AddOp::Sub,
};
AddTerm: AddTerm = { <op:AddOp> <m:MulExpr> => (op, m) };
AddExpr: AddExpr = {
    <h:MulExpr> <t:AddTerm*> => splice((AddOp::Add, h), t)
};

MulOp: MulOp = {
    "Mul" => MulOp::Mul,
    "Div" => MulOp::Div,
    "Mod" => MulOp::Mod,
};
MulFact: MulFact = { <op:MulOp> <u:UnaryExpr> => (op, u) };
MulExpr: MulExpr = { <u:UnaryExpr> <f:MulFact*> => splice((MulOp::Mul, u), f) };

UnaryOp: UnaryOp = {
    "Add" => UnaryOp::Add,
    "Sub" => UnaryOp::Sub,
    "Not" => UnaryOp::Not,
    "Tilde" => UnaryOp::Tilde,
};
UnaryExpr: UnaryExpr = {
    <op:UnaryOp> <e:UnaryExpr> => UnaryExpr::Term(op, Box::new(e)),
    <p:PostfixExpr> => UnaryExpr::Postfix(p),
};

PostfixExpr: PostfixExpr = {
    <h:PrimaryExpr> <t:PostfixOp*> => PostfixExpr::new(h, t)
};

PostfixOp: PostfixOp = {
    <c:Call> => PostfixOp::Call(c),
    <p:PostfixOpPrime> => PostfixOp::PostfixOpPrime(p),
};

PostfixOpPrime: PostfixOpPrime = {
    <i:Index> => PostfixOpPrime::Index(i),
    "Period" <id:"Identifier"> => PostfixOpPrime::Access(id.identifier()),
};

PrimaryExpr: PrimaryExpr = {
    <s:"StringLtrl"> => PrimaryExpr::StringLtrl(s.str_ltrl()),
    <c:"CharLtrl"> => PrimaryExpr::CharLtrl(c.char_ltrl()),
    <i:"IntegerLtrl"> => PrimaryExpr::IntegerLtrl(i.int_ltrl()),
    <f:"FloatLtrl"> => PrimaryExpr::FloatLtrl(f.float_ltrl()),
    <"TrueLtrl"> => PrimaryExpr::BoolLtrl(true),
    <"FalseLtrl"> => PrimaryExpr::BoolLtrl(false),
    "OpenParen" <Expr> "ClosParen" => PrimaryExpr::Expr(<>),
    <PrimaryExprPrime> => PrimaryExpr::Prime(<>),
};

PrimaryExprPrime: PrimaryExprPrime = {
    "Self" => PrimaryExprPrime::Self_,
    <q:QualName> => PrimaryExprPrime::QualName(q),
};

ShiftOp: ShiftOp = {
    "ShiftL" => ShiftOp::Left,
    "ShiftR" => ShiftOp::Right,
};

RelOp: RelOp = {
    "Eq" => RelOp::Eq,
    "Diamond" => RelOp::Diamond,
    "Lt" => RelOp::Lt,
    "Lte" => RelOp::Lte,
    "Gt" => RelOp::Gt,
    "Gte" => RelOp::Gte,
};
